From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Subject: [PATCH] Watch acquired serial consoles without taking ownership

Add an authenticated read-only watch for the local exporter's acquired UARTs.
Use ser2net's existing multiple-connection support to observe PC-owned places.
Discard all browser input on the server and keep writable consoles owner-only.
Close slow observers and end watches when acquisition or login expires.

Upstream-Status: Pending
Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>

--- /dev/null
+++ b/coordinator/api/app/console/watch.py
@@ -0,0 +1,52 @@
+"""Read-only serial observation with bounded buffering for slow browsers."""
+
+from __future__ import annotations
+
+import asyncio
+
+from .session import ConsoleSession
+
+
+class WatchSession(ConsoleSession):
+    async def watch(self, ws, still_acquired, authorized):
+        # Keep draining ser2net so a slow browser cannot stall the owner's UART
+        output = asyncio.Queue(maxsize=64)
+
+        async def read_serial():
+            while still_acquired():
+                data = await self._reader.read(4096)
+                if not data:
+                    return
+                try:
+                    output.put_nowait(data)
+                except asyncio.QueueFull:
+                    return
+
+        async def send_output():
+            while True:
+                data = await output.get()
+                if not still_acquired():
+                    return
+                await ws.send_bytes(data)
+
+        async def discard_input():
+            # Never forward browser bytes, Telnet commands or control messages
+            while True:
+                if (await ws.receive())["type"] == "websocket.disconnect":
+                    return
+
+        async def check_access():
+            while await authorized():
+                await asyncio.sleep(0.5)
+
+        tasks = [asyncio.create_task(coro()) for coro in
+                 (read_serial, send_output, discard_input, check_access)]
+        try:
+            done, _ = await asyncio.wait(tasks, return_when=asyncio.FIRST_COMPLETED)
+            for task in done:
+                task.result()
+        finally:
+            for task in tasks:
+                task.cancel()
+            await asyncio.gather(*tasks, return_exceptions=True)
+            await self.close()

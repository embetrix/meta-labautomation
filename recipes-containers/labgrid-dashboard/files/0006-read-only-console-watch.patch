+@router.websocket("/places/{place_name}/resources/{resource_name}/watch")
+async def watch_ws(websocket: WebSocket, place_name: str, resource_name: str):
+    sid = websocket.cookies.get(settings.session_cookie_name)
+    auth_store = websocket.app.state.auth_store
+    user = await auth_store.resolve_session(sid) if sid else None
+    if user is None:
+        await websocket.close(code=1008)
+        return
+
+    coord = websocket.app.state.coordinator
+    resource = coord.get_acquired_resource(place_name, resource_name)
+    if resource is None or resource.cls != "NetworkSerialPort":
+        await websocket.close(code=4403)
+        return
+
+    # Observation is supported for this controller's exporter
+    host = resource.params.get("host")
+    if host and host == os.environ.get("LABGRID_EXPORTER_HOST"):
+        host = "127.0.0.1"
+    if host not in ("127.0.0.1", "::1", "localhost"):
+        await websocket.close(code=4403)
+        return
+    port = resource.params.get("port")
+    if not isinstance(port, int) or not 0 < port < 65536:
+        await websocket.close(code=1011)
+        return
+
+    # Reserve one observer connection per UART, leaving room for the owner
+    key = (resource.exporter, resource.group, resource.name)
+    watchers = websocket.app.state.console_watchers
+    if key in watchers:
+        await websocket.close(code=4409)
+        return
+    watchers.add(key)
+    owner = coord.get_place(place_name).acquired
+    snapshot = resource.model_dump()
+
+    def still_acquired():
+        place = coord.get_place(place_name)
+        current = coord.get_acquired_resource(place_name, resource_name)
+        return (place is not None and place.acquired == owner
+                and current is not None and current.model_dump() == snapshot)
+
+    async def authorized():
+        return still_acquired() and await auth_store.resolve_session(sid) is not None
+
+    session = WatchSession(
+        host=host, port=port, protocol=resource.params.get("protocol", "rfc2217")
+    )
+    try:
+        await asyncio.wait_for(session.connect(), timeout=5)
+        if not await authorized():
+            await websocket.close(code=4403)
+            return
+        await websocket.accept()
+        await session.watch(websocket, still_acquired, authorized)
+    except (WebSocketDisconnect, OSError, ValueError, TimeoutError) as e:
+        logger.info("console watch ended: %s", e)
+    finally:
+        await session.close()
+        watchers.discard(key)
+        try:
+            await websocket.close()
+        except (RuntimeError, OSError):
+            pass

From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Subject: [PATCH] Use provisioned credentials and pinned container dependencies

Keep the existing labgrid 26.0 protocol version, remove the fixed upstream
administrator password, and pin base images supporting ARM64 and AMD64.

Upstream-Status: Inappropriate [layer deployment configuration]

Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>

--- a/coordinator/api/app/main.py
+++ b/coordinator/api/app/main.py
@@ -1,5 +1,6 @@
 import asyncio
 import logging
+import os
 from contextlib import asynccontextmanager
 
 from fastapi import FastAPI
@@ -103,11 +104,14 @@
     app.state.console_manager = cmgr
 
     if await auth_store.user_count() == 0:
-        await auth_store.create_user(username="analog", password="analog", role="admin")
+        # meta-labautomation: never create an administrator with a shared password.
+        username = os.environ.get("LG_INITIAL_ADMIN_USERNAME", "admin")
+        password = os.environ.get("LG_INITIAL_ADMIN_PASSWORD", "")
+        if not username or not 16 <= len(password.encode("utf-8")) <= 72:
+            raise RuntimeError("Provision LG_INITIAL_ADMIN_USERNAME and a 16-72 byte LG_INITIAL_ADMIN_PASSWORD")
+        await auth_store.create_user(username=username, password=password, role="admin")
         app.state.bootstrap_token = None
-        logger.warning("=" * 70)
-        logger.warning("FIRST RUN: Created default account: analog:analog (admin)")
-        logger.warning("=" * 70)
+        logger.info("Created provisioned dashboard administrator")
     else:
         app.state.bootstrap_token = None
 
--- a/coordinator/api/pyproject.toml
+++ b/coordinator/api/pyproject.toml
@@ -18,7 +18,7 @@
     "authlib>=1.3.0",
     "httpx>=0.27",
     "itsdangerous>=2.2.0",
-    "labgrid>=25.0",
+    "labgrid==26.0",
     "croniter>=2.0",
 ]
 
--- a/coordinator/api/Dockerfile
+++ b/coordinator/api/Dockerfile
@@ -1,6 +1,8 @@
-FROM python:3.12-slim
+# meta-labautomation: bookworm provides the upstream libiio0 dependency.
+FROM python:3.12-slim-bookworm@sha256:935c3c5b12357a7e10caa9c1e6ca5692344d97cf229832ef584be2cec9fc03df
 
-RUN apt-get update && apt-get install -y --no-install-recommends git openssh-client rsync libiio0 libiio-dev && rm -rf /var/lib/apt/lists/*
+RUN sed -i 's|http://|https://|g' /etc/apt/sources.list.d/debian.sources \
+    && apt-get update && apt-get install -y --no-install-recommends git openssh-client rsync libiio0 libiio-dev && rm -rf /var/lib/apt/lists/*
 
 WORKDIR /app
 
--- a/coordinator/web/Dockerfile
+++ b/coordinator/web/Dockerfile
@@ -1,5 +1,6 @@
+# meta-labautomation: pin multi-architecture base images.
 # Stage 1: Build
-FROM node:20-alpine AS build
+FROM node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293 AS build
 WORKDIR /app
 COPY package.json package-lock.json* ./
 RUN npm ci
@@ -7,7 +8,7 @@
 RUN npm run build
 
 # Stage 2: Serve
-FROM nginx:alpine
+FROM nginx:alpine@sha256:713fc2ebfd92e8217db451477182ee91944b123d2b1ee9fd5a8c6e91ca6c3a11
 COPY --from=build /app/dist /usr/share/nginx/html
 COPY nginx.conf /etc/nginx/conf.d/default.conf
 EXPOSE 80

From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Subject: [PATCH] Allow the uv build backend provided by OpenEmbedded

The project uses the standard uv_build module layout. Allow the 0.10
backend shipped by the wrynose layer instead of requiring a second,
older copy of the build backend.

Upstream-Status: Inappropriate [distribution build dependency]
Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>
---
 pyproject.toml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/pyproject.toml b/pyproject.toml
--- a/pyproject.toml
+++ b/pyproject.toml
@@ -21,7 +21,7 @@ dependencies = [
 ]
 
 [build-system]
-requires = ["uv_build>=0.8.2,<0.9.0"]
+requires = ["uv_build>=0.8.2,<0.11.0"]
 build-backend = "uv_build"
 
 [tool.uv.build-backend]

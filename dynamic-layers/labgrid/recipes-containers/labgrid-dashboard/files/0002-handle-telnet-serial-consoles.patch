From: Ayoub Zaki <ayoub.zaki@embetrix.com>
Subject: [PATCH] Decode Telnet framing for labgrid serial consoles

The upstream bridge forwards raw TCP bytes. Labgrid NetworkSerialPort defaults
to rfc2217, so handle Telnet negotiation and IAC escaping before forwarding
terminal bytes. Retain raw mode for resources explicitly configured as raw.
Map only the configured local exporter host/address to loopback so isolated
serial resources remain reachable from the host-networked API container.

Upstream-Status: Inappropriate [layer deployment configuration]

Signed-off-by: Ayoub Zaki <ayoub.zaki@embetrix.com>

--- a/coordinator/api/pyproject.toml
+++ b/coordinator/api/pyproject.toml
@@ -20,6 +20,7 @@
     "itsdangerous>=2.2.0",
     "labgrid==26.0",
     "croniter>=2.0",
+    "telnetlib3>=2.0,<3",
 ]
 
 [project.optional-dependencies]
--- a/coordinator/api/app/console/session.py
+++ b/coordinator/api/app/console/session.py
@@ -5,11 +5,14 @@
 import asyncio
 import logging
 
+import telnetlib3
+
 logger = logging.getLogger(__name__)
 
 
 class ConsoleSession:
-    def __init__(self, *, host: str, port: int, recorder=None):
+    def __init__(self, *, host: str, port: int, recorder=None, protocol="raw"):
+        self.protocol = protocol
         self.host = host
         self.port = port
         self.recorder = recorder
@@ -22,7 +25,16 @@
         return self._closed.is_set()
 
     async def connect(self) -> None:
-        self._reader, self._writer = await asyncio.open_connection(self.host, self.port)
+        # meta-labautomation: ser2net uses Telnet framing for rfc2217 resources.
+        if self.protocol == "rfc2217":
+            self._reader, self._writer = await telnetlib3.open_connection(
+                self.host, self.port, encoding=False,
+                connect_minwait=0.1, connect_maxwait=1.0,
+            )
+        elif self.protocol == "raw":
+            self._reader, self._writer = await asyncio.open_connection(self.host, self.port)
+        else:
+            raise ValueError(f"Unsupported serial protocol: {self.protocol}")
 
     async def close(self) -> None:
         if self._closed.is_set():
--- a/coordinator/api/app/console/manager.py
+++ b/coordinator/api/app/console/manager.py
@@ -30,13 +30,14 @@
         host: str,
         port: int,
         recorder=None,
+        protocol="raw",
     ) -> ConsoleSession:
         key = (place, resource)
         async with self._lock:
             existing = self._sessions.get(key)
             if existing is not None and not existing.is_closed:
                 return existing
-            s = ConsoleSession(host=host, port=port, recorder=recorder)
+            s = ConsoleSession(host=host, port=port, recorder=recorder, protocol=protocol)
             await s.connect()
             self._sessions[key] = s
             return s
